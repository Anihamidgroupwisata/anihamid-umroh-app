function ensureStorage() {
  if (!fs.existsSync(dataFilePath)) {
    fs.mkdirSync(path.dirname(dataFilePath), { recursive: true });
    fs.writeFileSync(dataFilePath, JSON.stringify(defaultData, null, 2));
  }
}

function readData() {
  ensureStorage();
  const raw = fs.readFileSync(dataFilePath, 'utf8');
  try {
    return JSON.parse(raw);
  } catch (error) {
    return defaultData;
  }
}

function writeData(nextData) {
  fs.writeFileSync(dataFilePath, JSON.stringify(nextData, null, 2));
}

const app = express();
const PORT = process.env.PORT || 4000;

app.use(cors());
app.use(express.json());

app.get('/api/health', (req, res) => {
  res.json({ ok: true, message: 'Anihamid API berjalan' });
});

app.get('/api/config', (req, res) => {
  const data = readData();
  res.json({
    site: data.site,
    packages: data.packages,
    agents: data.agents,
    admin: data.admin,
  });
});

app.get('/api/registrations', (req, res) => {
  const data = readData();
  res.json(data.registrations || []);
});

app.post('/api/admin/login', (req, res) => {
  const { username, password } = req.body || {};
  const { admin } = readData();

  if (username === admin.username && password === admin.password) {
    return res.json({ ok: true, message: 'Login berhasil' });
  }

  return res.status(401).json({ ok: false, message: 'Username atau password tidak valid' });
});

app.post('/api/registrations', (req, res) => {
  const payload = req.body || {};
  const data = readData();
  const item = {
    id: payload.id || cryptoId(),
    code: payload.code || `AH${Math.random().toString(36).slice(2, 8).toUpperCase()}`,
    fullName: payload.fullName || '',
    whatsapp: payload.whatsapp || '',
    packageId: payload.packageId || '',
    packageName: payload.packageName || '',
    departureDate: payload.departureDate || '',
    roomType: payload.roomType || '',
    participantCount: Number(payload.participantCount || 1),
    notes: payload.notes || '',
    agent: payload.agent || 'Belum ada agen',
    agentId: payload.agentId || null,
    source: payload.source || 'Public Dashboard',
    status: payload.status || 'Baru',
    createdAt: payload.createdAt || new Date().toISOString(),
  };

  data.registrations = [item, ...data.registrations];
  writeData(data);
  res.status(201).json(item);
});

app.put('/api/registrations/:id/status', (req, res) => {
  const { id } = req.params;
  const { status } = req.body || {};
  const data = readData();
  const index = data.registrations.findIndex((reg) => reg.id === id);

  if (index === -1) {
    return res.status(404).json({ ok: false, message: 'Pendaftaran tidak ditemukan' });
  }

  data.registrations[index].status = status || data.registrations[index].status;
  writeData(data);
  res.json({ ok: true, registration: data.registrations[index] });
});

app.put('/api/config', (req, res) => {
  const next = req.body || {};
  const data = readData();
  data.site = { ...data.site, ...(next.site || {}) };
  data.packages = next.packages || data.packages;
  data.agents = next.agents || data.agents;
  data.admin = { ...data.admin, ...(next.admin || {}) };
  writeData(data);
  res.json({ ok: true, data: { site: data.site, packages: data.packages, agents: data.agents, admin: data.admin } });
});

app.listen(PORT, () => {
  console.log(`Anihamid API ready at http://localhost:${PORT}`);
});

function cryptoId() {
  return `reg-${Date.now()}-${Math.random().toString(16).slice(2, 10)}`;
}
